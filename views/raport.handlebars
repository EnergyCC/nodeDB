<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="X-UA-Compatible" content="ie=edge" />
    <title>Document</title>
    <!-- UNUSED: service worker registration script is not needed for this print view -->
    <!-- <script src="/js/script.js"></script> -->
    <link rel="stylesheet" href="/css/bootstrap.min.css" />
</head>

<body style="background-color: white;color:#333">
    <div id="deviz" style="background-color: white">
        <!-- inceput -->
        <div class="unitate ml-5 mt-4">Unitatea: Service Cris&Jon S.R.L.</div>
        <div class="deviz mt-3">
            <h4 class="float-left ml-5">Comanda-Deviz nr.: {{ jResult.0.job_id }}</h4>
            <h4 class="float-right mr-5">DATA: {{ parseData jResult.0.data_adaugare }}</h4>
        </div>
        <table style="width:100%" class="ml-5">
            <tr>
                <td style="width:50%">Tip auto: {{ firstUpper pResult.0.tip_auto }}</td>
                <td style="width:50%">Nr. inmatriculare: {{ pResult.0.nr_inmatriculare }}</td>
            </tr>
            <tr>
                <td>Client: {{ firstUpper pResult.0.nume_client }}
                    &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; Nr.
                    Telefon:&nbsp;&nbsp; {{
                    pResult.0.nr_tel }}</td>
                <td>Serie caroserie: {{ pResult.0.serie_caroserie }}</td>
            </tr>
            <tr>
                <td>kilometri: {{ jResult.0.kilometri }}</td>
                <td>Serie Motor: {{ pResult.0.serie_motor }}</td>
            </tr>
        </table>

        <!-- tabel lucrari solicitate -->
        <div class="row mt-3">
            <div class="col-sm ml-5">
                <table style="width:90%">
                    <tr>
                        <th style="border-bottom: 2px solid">
                            Lucrari solicitate de client
                        </th>
                    </tr>
                    {{#each lucrari_sol_data}}
                    <tr>
                        <td style="border-bottom: 2px solid">{{this}}</td>
                    </tr>
                    {{/each}}
                </table>
            </div>
            <div class="col-sm mr-5">
                <table style="width:100%">
                    <tr>
                        <th style="border-bottom: 2px solid">
                            Piese client: (Garantia pieselor este asigurata numai de
                            furnizor)
                        </th>
                    </tr>
                    <tr>
                        <td style="border:2px solid;width:70%">Denumirea</td>
                        <td style="border:2px solid">Bucati</td>
                    </tr>
                    {{#each piese_client_data}}
                    <tr>
                        <td style="border:2px solid;width:70%">{{this.denumire}}</td>
                        <td style="border:2px solid">{{this.bucati}} &nbsp;</td>
                    </tr>
                    {{/each}}
                </table>
            </div>
        </div>

        <!-- tabel defecte -->
        <div class="row mt-3">
            <div class="col-sm ml-5 mr-5">
                <table style="width:100%">
                    <tr>
                        <th style="width:70%;border-top: 2px solid;border-left:2px solid;border-right:2px solid">
                            Defecte suplimentare constatate in timpul reparatiei
                        </th>
                        <th style="width:30%; border-top:2px solid;border-right: 2px solid">
                            Accept client
                        </th>
                    </tr>
                    {{#each defecte_data}}
                    <tr>
                        <td style="border-right: 2px solid;border-left:2px solid;
              border-bottom: 1px solid">
                            {{this}}&nbsp;
                        </td>
                        <td style="border-right:2px solid"></td>
                    </tr>
                    {{/each}}
                    <tr>
                        <td style="border-right:2px solid;border-left:2px solid;border-top:2px solid">
                            &nbsp;
                        </td>
                        <td style="border-top:2px solid;border-right: 2px solid">
                            Accept client/semnatura
                        </td>
                    </tr>
                    <tr>
                        <td style="border-right:2px solid; border-left: 2px solid;border-bottom:2px solid">
                            Termen de executie(estimativ): {{ jResult.0.termen_executie }} Ore
                        </td>
                        <td style="border-bottom:2px solid; border-right:2px solid"></td>
                    </tr>
                </table>
            </div>
        </div>
        <!-- tabel lucrari convenite -->
        <div class="mt-4 mr-5 ml-5">
            <table style="width: 100%" class="text-center">
                <tr>
                    <th style="border-bottom:1px solid" colspan="2">
                        Lucrari convenite cu clientul si executate
                    </th>
                </tr>
                <tr>
                    <th style="border:2px solid;width:10%">Nr. crt.</th>
                    <th style="border:2px solid;width:60%">Denmirea operatiei</th>
                    <th style="border:2px solid;width:10%">Timp ore</th>
                    <th style="border:2px solid;width:10%">Tarif ora</th>
                    <th style="border:2px solid;width:10%">Valoare lei</th>
                </tr>
                {{#each lucrari_convenite_data}}
                <tr>
                    <td style="border:2px solid;width:10%">{{this.index}}</td>
                    <td style="border:2px solid;width:60%">{{this.operatie}}</td>
                    <td style="border:2px solid;width:10%">{{this.timp}}</td>
                    <td style="border:2px solid;width:10%">{{../jResult.0.tarif_ora}} lei</td>
                    <td style="border:2px solid;width:10%">{{this.valoare}} lei</td>
                </tr>
                {{/each}}
                <tr>
                    <td style="border:2px solid;width:10%" colspan="2">
                        Regie manopera
                    </td>
                    <td style="border:2px solid;width:10%">{{ total_ore_operatie }} ore</td>
                    <td style="border:2px solid;width:10%"></td>
                    <td style="border:2px solid;width:10%">{{total_cost_val}} lei</td>
                </tr>
                <tr>
                    <td style="border:2px solid;width:10%" colspan="2">
                        Total
                    </td>
                    <td style="border:2px solid;width:10%"></td>
                    <td style="border:2px solid;width:10%"></td>
                    <td style="border:2px solid;width:10%">{{total_manopera}} lei</td>
                </tr>
            </table>
        </div>

        <!-- tabel piese materiale -->
        <div class="mt-4 mr-5 ml-5">
            <table style="width:100%" class="text-center">
                <tr>
                    <th style="border-bottom:1px solid" colspan="2">
                        Piese/materiale
                    </th>
                </tr>
                <tr>
                    <th style="border:2px solid;width:10%">Nr. crt.</th>
                    <th style="border:2px solid;width:50%">Denumirea piesa/material</th>
                    <th style="border:2px solid;width:10%">U/M</th>
                    <th style="border:2px solid;width:10%">Cantitate</th>
                    <th style="border:2px solid;width:10%">Pret unitar</th>
                    <th style="border:2px solid;width:10%">Valoare</th>
                </tr>
                {{#each piese_materiale_data}}
                <tr>
                    <td style="border:2px solid;width:10%">{{this.index}}</td>
                    <td style="border:2px solid;width:50%">{{this.denumire}}</td>
                    <td style="border:2px solid;width:10%">BUC</td>
                    <td style="border:2px solid;width:10%">{{this.cantitate}}</td>
                    <td style="border:2px solid;width:10%">{{this.pret}}</td>
                    <td style="border:2px solid;width:10%">{{this.valoare}}</td>
                </tr>
                {{/each}}
                <tr>
                    <td style="border:2px solid;width:10%" colspan="2">
                        Regie materiale
                    </td>
                    <td style="border:2px solid;width:10%"></td>
                    <td style="border:2px solid;width:10%"></td>
                    <td style="border:2px solid;width:10%"></td>
                    <td style="border:2px solid;width:10%">{{total_materiale}} lei</td>
                </tr>
                <tr>
                    <td style="visibility:hidden;font-size:1px;line-height:1px;padding:0;margin:0;">&nbsp;</td>
                    <td style="visibility:hidden;font-size:1px;line-height:1px;padding:0;margin:0;">&nbsp;</td>
                    <td style="visibility:hidden;font-size:1px;line-height:1px;padding:0;margin:0;">&nbsp;</td>
                    <td colspan="2" style="border-bottom:1px solid">Total manopera</td>
                    <td style="border-bottom:1px solid">{{total_manopera}} lei</td>
                </tr>
                <tr>
                    <td style="visibility:hidden;font-size:1px;line-height:1px;padding:0;margin:0;">&nbsp;</td>
                    <td style="visibility:hidden;font-size:1px;line-height:1px;padding:0;margin:0;">&nbsp;</td>
                    <td style="visibility:hidden;font-size:1px;line-height:1px;padding:0;margin:0;">&nbsp;</td>
                    <td colspan="2" style="border-bottom:1px solid">Total materiale</td>
                    <td style="border-bottom:1px solid">{{total_materiale}} lei</td>
                </tr>
                <tr>
                    <td style="visibility:hidden;font-size:1px;line-height:1px;padding:0;margin:0;">&nbsp;</td>
                    <td style="visibility:hidden;font-size:1px;line-height:1px;padding:0;margin:0;">&nbsp;</td>
                    <td style="visibility:hidden;font-size:1px;line-height:1px;padding:0;margin:0;">&nbsp;</td>
                    <td colspan="2"></td>
                    <td style="visibility:hidden;font-size:1px;line-height:1px;padding:0;margin:0;">&nbsp;</td>
                </tr>
                <tr>
                    <td></td>
                    <td></td>
                    <td></td>
                    <td style="border:2px solid">Total: </td>
                    <td colspan="2" style="border:2px solid">{{total_plata_ftva}} lei</td>
                </tr>
                <tr>
                    <td></td>
                    <td></td>
                    <td></td>
                    <td style="border:2px solid">TVA: </td>
                    <td colspan="2" style="border:2px solid">{{total_tva}} lei</td>
                </tr>
                <tr>
                    <td></td>
                    <td></td>
                    <td></td>
                    <td style="border:2px solid">Total plata: </td>
                    <td colspan="2" style="border:2px solid">{{total_plata}} lei</td>
                </tr>
            </table>
        </div>
        <!-- UNUSED: Excessive margin divs that could be simplified -->
        <!--
        <div class='mt-5'>&nbsp;</div>
        <div class='mt-5'>&nbsp;</div>
        <div class='mt-5'>&nbsp;</div>
        <div class='mt-5'>&nbsp;</div>
        -->
        <div class='mt-5'>&nbsp;</div>
        <div class='text mt-5 mr-5 ml-5'>
            <p class='text-center'>************CERTIFICAT DE CALITATE SI GARANTIE************</p>
            <p class='text-left'>Unitatea service garanteaza lucrarea executata*) si conformitatea acesteia**), potrivit
                L. 449/2003 si L. i 296/2004,</p>
            <p class='text-left'>* 3 luni de la data receptiei autovehiculului, daca lucrarea nu a necesitat inlocuiri
                de piese sau daca s-a executat cu piesa clientului</p>
            <p class='text-left'>** Garantia pieselor furnizate de unitate, in baza L. 449/2003 - conf. declaratiei
                producatorului prin conventie intre parti conditionat de resp. indicatiilor de exploatare prevazute de
                producatorul autovehiculului este de <b>3 luni</b></p>
            <p class='text-left'>*** La cererea beneficiarului unitatea va asigura vizualizarea activitatilor
                desfasurate si inregistrari care sa dovedeasca efectuarea inspectiilor finale</p>
            <p class='text-left'> Accept / solicit utilizarea pieselor reconditionate, reparate, reutilizabile ____</p>
            <p class='float-left mt-4'>Sef unitate, <br></p>
            <p class='float-right mt-4'>Client,<br> {{pResult.0.nume_client}}</p>
        </div>
        <div class='mt-5'>&nbsp;</div>

    </div>
    <script>
        window.onload = () => {
            window.print();
        }
    </script>
</body>

</html>