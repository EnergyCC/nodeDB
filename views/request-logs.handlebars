<div class="container-fluid mt-4">
  <div class="row">
    <div class="col-12">
      <h2><i class="fas fa-chart-bar"></i> Request Monitoring</h2>
      
      <!-- Stats Summary -->
      <div class="row mb-4">
        <div class="col-md-3">
          <div class="card bg-primary text-white">
            <div class="card-body">
              <h5 class="card-title">Total Requests</h5>
              <h3>{{stats.totalRequests}}</h3>
            </div>
          </div>
        </div>
        <div class="col-md-3">
          <div class="card bg-success text-white">
            <div class="card-body">
              <h5 class="card-title">Avg Response Time</h5>
              <h3>{{stats.averageResponseTime}}ms</h3>
            </div>
          </div>
        </div>
        <div class="col-md-3">
          <div class="card bg-info text-white">
            <div class="card-body">
              <h5 class="card-title">Status Codes</h5>
              <h3>{{Object.keys(stats.statusCodeDistribution).length}}</h3>
            </div>
          </div>
        </div>
        <div class="col-md-3">
          <div class="card bg-warning text-white">
            <div class="card-body">
              <h5 class="card-title">Top Endpoints</h5>
              <h3>{{stats.mostRequestedEndpoints.length}}</h3>
            </div>
          </div>
        </div>
      </div>
      
      <!-- Status Code Distribution -->
      <div class="card mb-4">
        <div class="card-header">
          <h4><i class="fas fa-chart-pie"></i> Status Code Distribution</h4>
        </div>
        <div class="card-body">
          <div class="row">
            {{#each stats.statusCodeDistribution}}
            <div class="col-md-3">
              <div class="alert alert-info">
                <strong>{{@key}}xx:</strong> {{this}} requests
              </div>
            </div>
            {{/each}}
          </div>
        </div>
      </div>
      
      <!-- Most Requested Endpoints -->
      <div class="card mb-4">
        <div class="card-header">
          <h4><i class="fas fa-route"></i> Most Requested Endpoints</h4>
        </div>
        <div class="card-body">
          <table class="table table-striped">
            <thead>
              <tr>
                <th>Endpoint</th>
                <th>Request Count</th>
              </tr>
            </thead>
            <tbody>
              {{#each stats.mostRequestedEndpoints}}
              <tr>
                <td>{{this.endpoint}}</td>
                <td>{{this.count}}</td>
              </tr>
              {{/each}}
            </tbody>
          </table>
        </div>
      </div>
      
      <!-- Recent Requests -->
      <div class="card">
        <div class="card-header">
          <h4><i class="fas fa-history"></i> Recent Requests (Last 100)</h4>
        </div>
        <div class="card-body">
          <div class="table-responsive">
            <table class="table table-striped table-hover">
              <thead>
                <tr>
                  <th>Timestamp</th>
                  <th>Method</th>
                  <th>URL</th>
                  <th>Status</th>
                  <th>Response Time</th>
                  <th>Size</th>
                  <th>IP</th>
                  <th>User Agent</th>
                </tr>
              </thead>
              <tbody>
                {{#each logs}}
                <tr>
                  <td>{{this.timestamp}}</td>
                  <td><span class="badge badge-primary">{{this.method}}</span></td>
                  <td>{{this.url}}</td>
                  <td>
                    {{#if (eq (floor this.statusCode 100) 2)}}
                      <span class="badge badge-success">{{this.statusCode}}</span>
                    {{else if (eq (floor this.statusCode 100) 3)}}
                      <span class="badge badge-info">{{this.statusCode}}</span>
                    {{else if (eq (floor this.statusCode 100) 4)}}
                      <span class="badge badge-warning">{{this.statusCode}}</span>
                    {{else if (eq (floor this.statusCode 100) 5)}}
                      <span class="badge badge-danger">{{this.statusCode}}</span>
                    {{else}}
                      <span class="badge badge-secondary">{{this.statusCode}}</span>
                    {{/if}}
                  </td>
                  <td>{{this.responseTime}}ms</td>
                  <td>{{this.responseSize}} bytes</td>
                  <td>{{this.clientIP}}</td>
                  <td>{{this.userAgent}}</td>
                </tr>
                {{/each}}
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>