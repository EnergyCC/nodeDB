        // Show loading overlay
        function showLoading() {
            document.getElementById('loadingOverlay').style.display = 'flex';
        }
        
        // Hide loading overlay
        function hideLoading() {
            document.getElementById('loadingOverlay').style.display = 'none';
        }
        
        // Add loading indicators to form submissions
        document.addEventListener('DOMContentLoaded', function() {
            // Add loading indicator to all forms
            const forms = document.querySelectorAll('form');
            forms.forEach(form => {
                form.addEventListener('submit', function() {
                    showLoading();
                });
            });
            
            // Add loading indicator to buttons that trigger long operations
            const longOpButtons = document.querySelectorAll('button[data-loading]');
            longOpButtons.forEach(button => {
                button.addEventListener('click', function() {
                    showLoading();
                });
            });
        });
    </script>
</body>

</html>