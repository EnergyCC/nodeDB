<section id="ip-logs">
    <div class="card">
        <div class="card-header bg-primary text-white">
            <h4 class="mb-0"><i class="fas fa-network-wired"></i> IP Logs</h4>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped table-bordered">
                    <thead class="thead-dark">
                        <tr>
                            <th>ID</th>
                            <th>IP Address</th>
                            <th>User Agent</th>
                            <th>Action</th>
                            <th>Timestamp</th>
                        </tr>
                    </thead>
                    <tbody>
                        {{#each logs}}
                        <tr>
                            <td>{{id}}</td>
                            <td>{{ip_address}}</td>
                            <td>{{user_agent}}</td>
                            <td>{{action}}</td>
                            <td>{{parseData timestamp}}</td>
                        </tr>
                        {{/each}}
                    </tbody>
                </table>
            </div>
            <a href="/index" class="btn btn-secondary">
                <i class="fas fa-arrow-left"></i> Back to Dashboard
            </a>
        </div>
    </div>
</section>