<section id="results-content">
    <div class="card mb-4">
        <div class="card-header">
            <h5 class="card-title mb-0"><i class="fas fa-search"></i> Cautare</h5>
        </div>
        <div class="card-body">
            <form class="form-inline" action="/index/" method="POST">
                <div class="form-group mb-2 mr-sm-3">
                    <label for="searchQuery" class="sr-only">Cauta</label>
                    <input type="text" class="form-control" id="searchQuery" placeholder="Cauta" name="searchQuery">
                </div>
                <div class="form-group mb-2 mr-sm-3">
                    <label for="searchParam" class="sr-only">Cautare dupa</label>
                    <select class="custom-select" id="searchParam" name="searchParam">
                        <option value="nume_client">Nume</option>
                        <option value="nr_inmatriculare">Nr. inmatriculare</option>
                        <option value="tip_auto">Tip auto</option>
                    </select>
                </div>
                <button type="submit" class="btn btn-primary mb-2"><i class="fas fa-search mr-1"></i> Cauta</button>
            </form>
        </div>
    </div>

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="mb-0"><i class="fas fa-list"></i> Rezultate</h2>
        <button id="toggleView" class="btn btn-secondary" data-view="detailed">
            <i class="fas fa-th-large"></i> Vizualizare Compacta
        </button>
    </div>
    
    {{#if results}}
        <div id="detailedView" class="view-container">
            <div class="row">
                {{#each results}}
                <div class="col-lg-6 mb-4">
                    <div class="card">
                        <div class="card-header bg-primary text-white">
                            <div class="row align-items-center">
                                <div class="col-sm-6">
                                    <h5 class="mb-0">{{firstUpper nume_client}}</h5>
                                </div>
                                <div class="col-sm-6 text-right">
                                    <a href="/index/view/{{profile_id}}" class="btn btn-light btn-sm mr-1" title="Vezi lucrari">
                                        <i class="fas fa-eye" style="margin-right: 0;"></i>
                                    </a>
                                    <a href="/edit/profile/{{profile_id}}" class="btn btn-light btn-sm mr-1" title="Editare">
                                        <i class="fas fa-edit" style="margin-right: 0;"></i>
                                    </a>
                                    <a href="/remove/profile/{{profile_id}}" class="btn btn-danger btn-sm" title="Sterge">
                                        <i class="fas fa-trash" style="margin-right: 0;"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-6">
                                    <p class="card-text"><strong>Tip auto:</strong> {{firstUpper tip_auto}}</p>
                                    <p class="card-text"><strong>Numar inmatriculare:</strong> {{nr_inmatriculare}}</p>
                                </div>
                                <div class="col-md-6">
                                    <p class="card-text"><strong>Serie caroserie:</strong> {{serie_caroserie}}</p>
                                    <p class="card-text"><strong>Serie motor:</strong> {{serie_motor}}</p>
                                </div>
                            </div>
                            <div class="row mt-3">
                                <div class="col-12">
                                    <a href="/add/jobs/{{profile_id}}" class="btn btn-success btn-block">
                                        <i class="fas fa-plus-circle"></i> Adauga lucrare
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                {{/each}}
            </div>
        </div>
        
        <div id="compactView" class="view-container" style="display: none;">
            <div class="row">
                <div class="col-12">
                    <div class="card">
                        <div class="card-body p-0">
                            <div class="table-responsive">
                                <table class="table table-hover mb-0">
                                    <thead class="thead-dark">
                                        <tr>
                                            <th scope="col">Client</th>
                                            <th scope="col">Auto</th>
                                            <th scope="col">Nr. Inmatriculare</th>
                                            <th scope="col" class="text-center">Actiuni</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        {{#each results}}
                                        <tr>
                                            <td>{{firstUpper nume_client}}</td>
                                            <td>{{firstUpper tip_auto}}</td>
                                            <td>{{nr_inmatriculare}}</td>
                                            <td class="text-center">
                                                <a href="/index/view/{{profile_id}}" class="btn btn-primary btn-sm mr-1" title="Vezi lucrari">
                                                    <i class="fas fa-eye" style="margin-right: 0;"></i>
                                                </a>
                                                <a href="/edit/profile/{{profile_id}}" class="btn btn-warning btn-sm mr-1" title="Editare">
                                                    <i class="fas fa-edit" style="margin-right: 0;"></i>
                                                </a>
                                                <a href="/add/jobs/{{profile_id}}" class="btn btn-success btn-sm mr-1" title="Adauga lucrare">
                                                    <i class="fas fa-plus" style="margin-right: 0;"></i>
                                                </a>
                                                <a href="/remove/profile/{{profile_id}}" class="btn btn-danger btn-sm" title="Sterge">
                                                    <i class="fas fa-trash" style="margin-right: 0;"></i>
                                                </a>
                                            </td>
                                        </tr>
                                        {{/each}}
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    {{else}}
        <div class="alert alert-info">
            <h4 class="alert-heading"><i class="fas fa-info-circle"></i> Nu sunt rezultate</h4>
            <p>Nu s-au gasit inregistrari care sa corespunda criteriilor de cautare.</p>
            <hr>
            <a href="/add/profile" class="btn btn-primary"><i class="fas fa-plus-circle"></i> Adauga un nou profil</a>
        </div>
    {{/if}}
</section>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const toggleButton = document.getElementById('toggleView');
    const detailedView = document.getElementById('detailedView');
    const compactView = document.getElementById('compactView');
    
    // Load saved view preference from localStorage
    const savedView = localStorage.getItem('profileViewPreference') || 'detailed';
    
    // Apply saved view preference
    if (savedView === 'compact') {
        detailedView.style.display = 'none';
        compactView.style.display = 'block';
        toggleButton.setAttribute('data-view', 'compact');
        toggleButton.innerHTML = '<i class="fas fa-th-large"></i> Vizualizare Detaliata';
    } else {
        // Default to detailed view
        detailedView.style.display = 'block';
        compactView.style.display = 'none';
        toggleButton.setAttribute('data-view', 'detailed');
        toggleButton.innerHTML = '<i class="fas fa-th-large"></i> Vizualizare Compacta';
    }
    
    toggleButton.addEventListener('click', function() {
        const currentView = toggleButton.getAttribute('data-view');
        
        if (currentView === 'detailed') {
            // Switch to compact view
            detailedView.style.display = 'none';
            compactView.style.display = 'block';
            toggleButton.setAttribute('data-view', 'compact');
            toggleButton.innerHTML = '<i class="fas fa-th-large"></i> Vizualizare Detaliata';
            // Save preference to localStorage
            localStorage.setItem('profileViewPreference', 'compact');
        } else {
            // Switch to detailed view
            compactView.style.display = 'none';
            detailedView.style.display = 'block';
            toggleButton.setAttribute('data-view', 'detailed');
            toggleButton.innerHTML = '<i class="fas fa-th-large"></i> Vizualizare Compacta';
            // Save preference to localStorage
            localStorage.setItem('profileViewPreference', 'detailed');
        }
    });
});
</script>